---
import { about, stats } from '../data/site';
---

<section id="about" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="reveal grid gap-12 md:grid-cols-[0.9fr_1.1fr] md:items-start">
      <div class="md:sticky md:top-24">
        <p class="text-sm text-accent">About</p>
        <h2 class="mt-3 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
          A developer who ships the <span class="text-accent">whole thing</span>.
        </h2>
      </div>
      <div class="space-y-5 text-base leading-relaxed text-muted sm:text-lg">
        {about.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <!-- Diubah jadi 3 kolom di mobile -->
    <dl class="reveal mt-16 grid grid-cols-3 gap-px overflow-hidden rounded-2xl border border-line bg-line">
      {stats.map((stat) => (
        <div class="flex flex-col justify-center bg-bg p-4 sm:p-8">
          <dd class="text-3xl font-semibold text-accent sm:text-5xl lg:text-6xl">{stat.value}</dd>
          <dt class="mt-1 text-[10px] leading-tight text-muted sm:mt-2 sm:text-sm">{stat.label}</dt>
        </div>
      ))}
    </dl>
  </div>
</section>