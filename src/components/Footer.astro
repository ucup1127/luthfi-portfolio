  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-8 text-sm text-muted/80 sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <p>&copy; {year} {profile.name}</p>
    <p>Built with Astro & Tailwind</p>
  </div>
</footer>