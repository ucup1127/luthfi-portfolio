---
import { featured, others } from '../data/site';

const shotModules = import.meta.glob('/src/assets/projects/mtsmuhbms-*.{png,jpg,jpeg,webp}', {
  eager: true, query: '?url', import: 'default',
}) as Record<string, string>;
const shots = Object.keys(shotModules).sort().map((k) => shotModules[k]);
---

<section id="projects" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    
    <div class="reveal">
      <p class="text-sm text-accent">Work</p>
      <h2 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">Projects</h2>
    </div>

    <!-- Featured Project -->
    <article class="reveal reveal-delay-1 card-lift mt-12 grid gap-10 rounded-2xl border border-line bg-surface/30 p-5 sm:p-8 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <p class="text-xs font-medium uppercase tracking-wider text-accent">Featured project</p>
        <h3 class="mt-3 text-3xl font-semibold sm:text-4xl">{featured.name}</h3>
        <p class="mt-3 text-base leading-snug sm:text-lg">{featured.tagline}</p>
        <p class="mt-2 text-sm text-muted">{featured.role}</p>
        <p class="mt-5 text-sm leading-relaxed text-muted sm:text-base">{featured.summary}</p>

        <ul class="mt-5 space-y-3 text-sm text-muted">
          {featured.highlights.map((item) => (
            <li class="flex gap-3 leading-relaxed">
              <span class="mt-2 h-1 w-3 shrink-0 bg-accent" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tech stack">
          {featured.stack.map((tech) => (
            <li class="rounded-full border border-line px-3 py-1 text-xs text-muted">{tech}</li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-3">
        {shots.length > 0 ? (
          <div class="grid gap-3 sm:grid-cols-2">
            {shots.slice(0, 5).map((src, i) => (
              <figure class={`overflow-hidden rounded-xl border border-line bg-surface ${i === 0 ? 'sm:col-span-2' : ''}`}>
                <img src={src} alt={`MTSMUHBMS screen ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" class="h-auto w-full" />
              </figure>
            ))}
          </div>
        ) : (
          <div class="flex aspect-[16/10] items-center justify-center rounded-xl border border-dashed border-line bg-surface text-sm text-muted">
            Screenshots coming soon
          </div>
        )}
      </div>
    </article>

    <!-- More Work -->
    <div class="reveal reveal-delay-2 mt-20">
      <h3 class="text-2xl font-semibold">More work</h3>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {others.map((project) => (
          <li class="card-lift rounded-xl border border-line bg-surface/20 p-5 sm:p-6">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-lg font-semibold">{project.name}</p>
                <p class="mt-1 text-xs text-muted">{project.context}</p>
              </div>
              {project.repo && (
                <a href={project.repo} class="shrink-0 text-xs text-accent underline underline-offset-4" target="_blank" rel="noopener noreferrer">Code</a>
              )}
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted">{project.description}</p>
            {project.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="rounded-full border border-line px-2.5 py-0.5 text-[11px] text-muted">{tag}</span>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>